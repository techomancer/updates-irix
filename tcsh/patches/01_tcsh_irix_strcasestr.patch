+#ifndef HAVE_STRCASESTR
+static char *
+tcsh_strcasestr(const char *haystack, const char *needle)
+{
+    size_t nlen;
+    if (!haystack || !needle)
+        return NULL;
+    nlen = strlen(needle);
+    for (; *haystack; haystack++) {
+        if (strncasecmp(haystack, needle, nlen) == 0)
+            return (char *)haystack;
+    }
+    return NULL;
+}
+#define strcasestr tcsh_strcasestr
